{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech.gov.uk/schema/guidance-catalogue/v0/entry.schema.json",
  "title": "Catalogue entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "short_description", "long_description",
    "type", "scope", "tags", "professions", "owner", "source"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "short_description": { "type": "string", "minLength": 1, "maxLength": 180 },
    "long_description": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "type": { "$ref": "#/$defs/key" },
    "primary": { "type": "boolean", "default": false },
    "scope": { "$ref": "#/$defs/key" },
    "tags": { "$ref": "#/$defs/keys" },
    "professions": { "$ref": "#/$defs/keys" },
    "status": { "enum": ["current", "draft", "withdrawn"], "default": "current" },
    "applies_to": { "type": "string", "minLength": 1, "maxLength": 300 },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organisation"],
      "properties": {
        "organisation": { "type": "string", "minLength": 1 },
        "team": { "type": "string", "minLength": 1 },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
            "url": { "type": "string", "pattern": "^https://" },
            "slack": { "type": "string", "pattern": "^#[a-z0-9_-]+$" }
          }
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "path"],
          "properties": {
            "type": { "const": "external" },
            "name": { "$ref": "#/$defs/source_name" },
            "path": { "type": "string", "pattern": "^https://" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "path"],
          "properties": {
            "type": { "const": "repo" },
            "name": { "$ref": "#/$defs/source_name" },
            "path": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
            "branch": { "type": "string", "minLength": 1, "default": "main" },
            "directory": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$" },
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "path"],
          "properties": {
            "type": { "const": "hosted" },
            "name": { "$ref": "#/$defs/source_name" },
            "path": { "type": "string", "pattern": "^content/[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$" }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "source_name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    }
  }
}
